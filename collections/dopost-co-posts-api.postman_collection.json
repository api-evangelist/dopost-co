          "id": "cccbd73c-bedd-4ec4-8ca2-00dc14516ff9",
          "name": "Publish or schedule a post",
          "request": {
            "name": "Publish or schedule a post",
            "description": {
              "content": "Publish a post immediately or schedule it for a future time on a single connected\nsocial account. When `publishAt` is `null`, the post publishes immediately. When\n`publishAt` is an ISO 8601 timestamp, the post is scheduled.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "post",
                "publish"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"<string>\",\n  \"text\": \"<string>\",\n  \"publishAt\": \"<string,null-date-time>\",\n  \"mediaIds\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"instagram\": {\n    \"key_0\": 5656.541308121844\n  },\n  \"facebook\": {\n    \"key_0\": 6771.627580519579\n  },\n  \"tiktok\": {\n    \"key_0\": 8545,\n    \"key_1\": \"string\"\n  },\n  \"pinterest\": {\n    \"key_0\": true\n  },\n  \"x\": {\n    \"key_0\": false\n  },\n  \"youtube\": {\n    \"key_0\": 7767\n  }\n}",
